# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (OpenAI-compatible API)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Harness record and replay: live (default), record or replay.
HARNESS_MODE=live
# Cassette folder for record and replay. Empty means runs/cassettes (gitignored).
HARNESS_CASSETTE_DIR=

# Tavily (web search tool for the researcher operator)
TAVILY_API_KEY=

# Shared store (production). Leave empty to use local SQLite.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Safety caps for the public live demo (USD)
LIVE_DEMO_MAX_USD_PER_RUN=0.25
LIVE_DEMO_MAX_USD_PER_DAY=3.00
