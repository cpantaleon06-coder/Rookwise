          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sender": {
          "enum": [
            "user",
            "director",
            "vp"
          ],
          "title": "Sender",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "ts": {
